# ---------------------------------------------------------------------------
# klipper-layer-resume: three additions to your existing macros.
# Do NOT paste these as new macros - merge the marked lines into yours.
# ---------------------------------------------------------------------------

[gcode_macro PRINT_START]
gcode:
  # ... your existing start sequence, unchanged ...
  PLR_BEGIN                    # <-- ADD, as the last line


[gcode_macro PRINT_END]
gcode:
  PLR_FINISH                   # <-- ADD, as the first line
  # ... your existing end sequence, unchanged ...


[gcode_macro CANCEL_PRINT]
rename_existing: CANCEL_PRINT_BASE
gcode:
  TURN_OFF_HEATERS
  PLR_FINISH                   # <-- ADD, anywhere in the body
  # ... your existing cancel sequence, unchanged ...
  CANCEL_PRINT_BASE

# PAUSE and RESUME need no changes. A pause is not a power loss and the
# recovery point stays valid across one.
